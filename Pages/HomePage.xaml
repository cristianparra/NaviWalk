<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NaviWalk.ViewModels"
             xmlns:models="clr-namespace:NaviWalk.Models"
             xmlns:views="clr-namespace:NaviWalk.Views"
             xmlns:icons="clr-namespace:NaviWalk.Helpers"
             x:Class="NaviWalk.Pages.HomePage"
             x:DataType="vm:HomeViewModel">

    <Grid RowDefinitions="*,Auto">
        <!-- Pull-to-refresh: IsRefreshing es OneWay para no chocar con el IsBusy del ViewModel. -->
        <RefreshView IsRefreshing="{Binding IsBusy, Mode=OneWay}" Command="{Binding LoadCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="0,24,0,16" Spacing="20">

                    <!-- Encabezado -->
                    <Grid ColumnDefinitions="*,Auto" Padding="20,0,10,0">
                        <VerticalStackLayout>
                            <Label Text="{Binding Greeting}" Style="{StaticResource Title1}" />
                            <Label Text="{Binding SourceName}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <views:IconButton Grid.Column="1" Data="{x:Static icons:Icons.SignOut}" Command="{Binding SwitchSourceCommand}"
                                          IconColor="{StaticResource TextSecondary}" VerticalOptions="Start" />
                    </Grid>

                    <!-- Error de carga con acciones de recuperación -->
                    <Border IsVisible="{Binding HasError}" Style="{StaticResource Card}" Margin="20,0">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Button Text="Reintentar" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}" HeightRequest="44" />
                                <Button Grid.Column="1" Text="Cambiar fuente" Command="{Binding SwitchSourceCommand}"
                                        Style="{StaticResource SecondaryButton}" HeightRequest="44" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Filas de álbumes -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sections}" Spacing="24">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:AlbumSection">
                                <VerticalStackLayout Spacing="12">
                                    <Label Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="20,0" />
                                    <CollectionView ItemsSource="{Binding Albums}" HeightRequest="230" SelectionMode="None">
                                        <CollectionView.ItemsLayout>
                                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="14" />
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.Header><BoxView WidthRequest="6" Color="Transparent" /></CollectionView.Header>
                                        <CollectionView.Footer><BoxView WidthRequest="6" Color="Transparent" /></CollectionView.Footer>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="models:Album">
                                                <views:AlbumCard WidthRequest="160">
                                                    <views:AlbumCard.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel, Path=OpenAlbumCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </views:AlbumCard.GestureRecognizers>
                                                </views:AlbumCard>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <views:BottomChrome Grid.Row="1" ActiveTab="Home" />
    </Grid>
</ContentPage>
