<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:NaviWalk.Views"
             xmlns:icons="clr-namespace:NaviWalk.Helpers"
             x:Class="NaviWalk.Pages.StartupPage">
    <!-- Pantalla transitoria: mientras se restaura la sesión guardada. No pide login. -->
    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="24">
        <views:IconButton Data="{x:Static icons:Icons.MusicNote}" IconSize="72" IconColor="{StaticResource Accent}" />
        <ActivityIndicator IsRunning="True" />
    </VerticalStackLayout>
</ContentPage>
