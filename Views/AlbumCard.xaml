<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:NaviWalk.Views"
             xmlns:models="clr-namespace:NaviWalk.Models"
             x:Class="NaviWalk.Views.AlbumCard"
             x:DataType="models:Album">
    <!-- Tarjeta de álbum: carátula cuadrada + título + artista. Usa el Album del BindingContext. -->
    <VerticalStackLayout Spacing="6">
        <views:CoverView Source="{Binding Cover}" IsSquare="True" CornerRadius="10" />
        <Label Text="{Binding Title}" Style="{StaticResource RowTitle}" FontSize="14" FontAttributes="Bold" />
        <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
    </VerticalStackLayout>
</ContentView>
