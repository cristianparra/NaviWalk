<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Paleta de la app: grises oscuros + naranja de énfasis (inspirada en los Walkman de Sony).
        Para cambiar el look completo basta con editar estos valores.
    -->
    <Color x:Key="Background">#121212</Color>
    <Color x:Key="Surface">#1E1E1E</Color>
    <Color x:Key="SurfaceHigh">#2A2A2A</Color>
    <Color x:Key="Divider">#333333</Color>

    <Color x:Key="Accent">#FF6A00</Color>
    <Color x:Key="AccentPressed">#CC5500</Color>
    <Color x:Key="OnAccent">#121212</Color>

    <Color x:Key="TextPrimary">#F2F2F2</Color>
    <Color x:Key="TextSecondary">#A0A0A0</Color>
    <Color x:Key="TextDisabled">#5C5C5C</Color>
    <Color x:Key="Error">#FF5C5C</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="SurfaceHighBrush" Color="{StaticResource SurfaceHigh}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
</ResourceDictionary>
